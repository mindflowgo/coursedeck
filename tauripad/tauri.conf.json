{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CourseDeck",
  "version": "0.1.1",
  "identifier": "com.rezox.coursedeck",
  "build": {
    "beforeBuildCommand": "bun --cwd ../app build",
    "frontendDist": "../app/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CourseDeck",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: tauri: asset:; img-src 'self' tauri: asset: data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://* https://* ws://*;"
    }
  },
  "bundle": {
    "active": true,
    "iOS": {
      "developmentTeam": "U5492M2JQ5"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
