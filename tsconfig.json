{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "$lib": ["./app/src/lib"],
      "$lib/*": ["./app/src/lib/*"]
    }
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts", "app/src/lib/server/**/*.ts", "app/src/app.d.ts"]
}
