{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CourseDeck",
  "version": "0.1.0",
  "identifier": "com.rezox.coursedeck",
  "build": {
    "beforeDevCommand": "bun --cwd ../app dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run ../scripts/fetch-pdfium.ts && bun --cwd ../app build",
    "frontendDist": "../app/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CourseDeck",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ilcstudy"]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "server*",
      "bin/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
