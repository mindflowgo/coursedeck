{
  "name": "ilc-study-tool-tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "bun run ../scripts/preflight-build.ts && tauri build",
    "build:mac": "tauri build --bundles dmg",
    "build:win": "bun run ../scripts/preflight-build.ts && tauri build --bundles nsis",
    "build:portable": "bun run --cwd .. tauri:build:portable",
    "build:win:portable": "bun run --cwd .. tauri:build:win:portable",
    "cargo:check": "cargo check",
    "cargo:build": "cargo build --release"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}
