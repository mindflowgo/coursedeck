{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the CourseDeck desktop window",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "window-state:default",
    "dialog:default",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*/*" },
        { "url": "https://*:*/*" },
        { "url": "http://*:*" },
        { "url": "https://*:*" },
        { "url": "http://*/*" },
        { "url": "https://*/*" },
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
