{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "ios",
  "description": "Default permissions for the CourseDeck iPad app",
  "platforms": [
    "iOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*/*" },
        { "url": "https://*:*/*" },
        { "url": "http://*:*" },
        { "url": "https://*:*" },
        { "url": "http://*/*" },
        { "url": "https://*/*" },
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    },
    "dialog:default",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "dialog:allow-save",
    "barcode-scanner:default",
    "pencilkit:default"
  ]
}
